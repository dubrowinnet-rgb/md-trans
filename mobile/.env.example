EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Необязательно (доработки 3, п.2) — автоподсказки адреса при вводе в форме
# заказа. Без ключа подсказки просто не показываются, остальное приложение
# работает как обычно. Ключ — «клиентский» (Geosuggest API), берётся в
# кабинете разработчика Яндекса: https://developer.tech.yandex.ru/
EXPO_PUBLIC_YANDEX_SUGGEST_API_KEY=
