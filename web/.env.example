# Те же значения, что и в mobile/.env (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Ключ Yandex Geosuggest API — живые подсказки адреса в форме заказа
# (https://developer.tech.yandex.ru/). Необязателен.
NEXT_PUBLIC_YANDEX_SUGGEST_API_KEY=
